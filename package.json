{
  "name": "vietjourney",
  "version": "0.1.0",
  "private": true,
  "description": "VietJourney - Tourist map app (Next.js + NestJS + Prisma + PostGIS)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "backend:dev": "nest start --watch",
    "backend:build": "nest build",
    "backend:start": "node dist/src/main.js",
    "backend:start:dev": "nest start",
    "backend:start:debug": "nest start --debug --watch",
    "backend:start:prod": "node dist/src/main.js",
    "backend:lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "backend:format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "backend:test": "jest",
    "backend:test:watch": "jest --watch",
    "backend:test:e2e": "jest --config ./test/jest-e2e.json",
    "backend:prisma:generate": "prisma generate",
    "backend:prisma:migrate": "prisma migrate dev",
    "backend:prisma:deploy": "prisma migrate deploy",
    "backend:prisma:studio": "prisma studio",
    "backend:db:seed": "ts-node prisma/seed.ts",
    "test:e2e:api": "node test/e2e-runner.mjs",
    "test:e2e:api:raw": "node test/e2e.mjs"
  },
  "dependencies": {
