{
  "name": "vietjourney",
  "version": "0.1.0",
  "private": true,
  "description": "VietJourney - Tourist map app (Next.js frontend + NestJS + Prisma + PostGIS backend)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "backend:build": "npm --prefix backend run build",
    "backend:start:dev": "npm --prefix backend run start:dev",
    "backend:start:prod": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test",
    "backend:db:seed": "npm --prefix backend run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose up -d --build api",
    "test:e2e:api": "node backend/test/e2e-runner.mjs",
    "test:e2e:api:raw": "node backend/test/e2e.mjs"
  }
}
