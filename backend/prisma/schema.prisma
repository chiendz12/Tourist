// Tourist Map — Prisma schema
// PostGIS-enabled. Geometry columns are added via raw SQL migration
// (Prisma supports `Unsupported("geometry(Point,4326)")`).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────
enum Role {
  GUEST
  MEMBER
  STUDENT
  LEADER
  LECTURER
  SUPER_ADMIN
}

enum HocPhanCode {
  HP1 // Nhập môn / điểm đến
  HP2 // Tuyến điểm
  HP3 // Quản lý & điều hành tour
}

enum EntityType {
  DESTINATION
  ROUTE
  TOUR
  SUPPLIER
  TOUR_COST
}

enum ApprovalStatus {
  DRAFT
  PENDING_LEADER
  PENDING_LECTURER
  PENDING_ADMIN
  PUBLISHED
  REJECTED
}

enum ApprovalLevel {
  LEADER
  LECTURER
  ADMIN
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  REVISE
}

enum SupplierType {
  HOTEL
  RESTAURANT
  TRANSPORT
  GUIDE
  OTHER
}

enum DestinationCategory {
  NATURE
  CULTURE
  HISTORY
  CUISINE
  ENTERTAINMENT
  RELIGION
  OTHER
}

/// Controlled vocabulary so "đầy đủ chi phí" (HP3) can actually be measured.
enum CostCategory {
  HOTEL
  MEAL
  TRANSPORT
  TICKET
  GUIDE
  INSURANCE
  MISC
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ModerationStatus {
  PENDING
  APPROVED
  HIDDEN
}

// ─────────────────────────────────────────────
// Tour design axes — HP2 "thiết kế tour theo: độ tuổi, hành vi, thời gian, mùa".
// ("thời gian" is already modelled by Tour.days.)
// ─────────────────────────────────────────────
enum AgeGroup {
  CHILD
  TEEN
  ADULT
  SENIOR
  FAMILY
  ALL
}

enum TravelStyle {
  RELAX
  ADVENTURE
  CULTURE
  CUISINE
  ECO
  EDUCATION
  SHOPPING
  NIGHTLIFE
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL_YEAR
}

// ─────────────────────────────────────────────
// Core: User / Province / HocPhan / Class
// ─────────────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  avatarUrl     String?
  role          Role     @default(MEMBER)
  isActive      Boolean  @default(true)
  // Self-registered STUDENT/LECTURER accounts start unapproved: a lecturer
  // (students) or an admin must approve before first sign-in. Existing rows
  // backfill to true via the migration default.
  isApproved    Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens     RefreshToken[]
  provinces         UserProvince[]
  hocPhanEnrollments HocPhanEnrollment[]
  classMemberships  ClassMember[]
  destinations      Destination[]    @relation("DestCreatedBy")
  routes            Route[]          @relation("RouteCreatedBy")
  tours             Tour[]           @relation("TourCreatedBy")
  ratings           Rating[]
  favorites         Favorite[]
  comments          Comment[]
  itineraries       Itinerary[]
  approvalsActed    ApprovalHistory[] @relation("ApprovalActor")
  notifications     Notification[]
  auditLogs         AuditLog[]
  suppliers         Supplier[]       @relation("SupplierCreatedBy")
  grades            Grade[]          @relation("GradeStudent")
  gradesGiven       Grade[]          @relation("GradeGrader")
  tasksCreated     Task[]           @relation("TaskCreatedBy")
  taskAssignments  TaskAssignment[] @relation("TaskAssignee")
  tasksAssigned    TaskAssignment[] @relation("TaskAssignedBy")

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Province {
  id      String  @id @default(uuid())
  code    String  @unique // e.g. "01" Ha Noi
  name    String
  region  String? // North/Central/South
  // bounding box / centroid (set via raw SQL)
  centroid Unsupported("geometry(Point,4326)")?

  users        UserProvince[]
  destinations Destination[]
  classes      Class[]
  suppliers    Supplier[]
}

model UserProvince {
  userId     String
  provinceId String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@id([userId, provinceId])
}

model HocPhan {
  id          String       @id @default(uuid())
  code        HocPhanCode  @unique
  name        String
  description String?
  enrollments HocPhanEnrollment[]
  classes     Class[]
  grades      Grade[]
  tasks       Task[]
}

model HocPhanEnrollment {
  userId    String
  hocPhanId String
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hocPhan   HocPhan  @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)

  @@id([userId, hocPhanId])
}

model Class {
  id         String    @id @default(uuid())
  name       String
  code       String    @unique
  hocPhanId  String
  lecturerId String?
  provinceId String?
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  hocPhan  HocPhan      @relation(fields: [hocPhanId], references: [id])
  province Province?    @relation(fields: [provinceId], references: [id])
  members  ClassMember[]
  groups   StudentGroup[]
  grades   Grade[]
  tasks    Task[]
}

model ClassMember {
  classId  String
  userId   String
  isLeader Boolean @default(false)
  groupId  String?
  joinedAt DateTime @default(now())

  class  Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group  StudentGroup?  @relation(fields: [groupId], references: [id])

  @@id([classId, userId])
}

model StudentGroup {
  id      String  @id @default(uuid())
  classId String
  name    String
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  members ClassMember[]
  tasks   Task[]
}

// ─────────────────────────────────────────────
// Spatial domain: Destination / Route / Tour
// ─────────────────────────────────────────────
model Destination {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?
  category    DestinationCategory @default(OTHER)
  address     String?
  provinceId  String?
  // PostGIS POINT (lng,lat) SRID 4326
  location    Unsupported("geometry(Point,4326)")
  images      Json? // string[]
  openingHours Json?
  ticketPrice Decimal? @db.Decimal(12, 2)
  status      ApprovalStatus @default(DRAFT)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  province  Province?    @relation(fields: [provinceId], references: [id])
  createdBy User         @relation("DestCreatedBy", fields: [createdById], references: [id])
  routePoints RouteWaypoint[]
  ratings   Rating[]
  comments  Comment[]
  itineraryItems TourItineraryItem[]
  favorites     Favorite[]

  @@index([provinceId])
  @@index([status])
}

model Route {
  id          String   @id @default(uuid())
  name        String
  description String?
  // LineString of the optimized path
  path        Unsupported("geometry(LineString,4326)")?
  distanceM   Float?
  durationS   Int?
  status      ApprovalStatus @default(DRAFT)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User             @relation("RouteCreatedBy", fields: [createdById], references: [id])
  waypoints RouteWaypoint[]
  tours     Tour[]

  @@index([status])
}

model RouteWaypoint {
  id            String @id @default(uuid())
  routeId       String
  destinationId String
  order         Int
  stayMinutes   Int?
  notes         String?

  route       Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([routeId, order])
  @@index([destinationId])
}

model Tour {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  routeId     String?
  days        Int      @default(1)
  /// Selling price per pax; TourCost rows hold the underlying cost.
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("VND")
  /// Group size the pricing is quoted for (HP3).
  paxCount    Int      @default(1)

  // HP2 design axes — used for public filtering and for grading "logic tuyến".
  targetAgeGroups AgeGroup[]
  travelStyles    TravelStyle[]
  seasons         Season[]

  status      ApprovalStatus @default(DRAFT)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  route       Route?     @relation(fields: [routeId], references: [id])
  createdBy   User       @relation("TourCreatedBy", fields: [createdById], references: [id])
  itinerary   TourItineraryItem[]
  costs       TourCost[]
  itineraries Itinerary[]

  @@index([status])
}

model TourItineraryItem {
  id            String @id @default(uuid())
  tourId        String
  dayNumber     Int
  startTime     String? // "08:00"
  endTime       String?
  destinationId String?
  description   String?
  order         Int

  tour        Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([tourId, dayNumber, order])
}

model Supplier {
  id          String       @id @default(uuid())
  name        String
  type        SupplierType
  provinceId  String?
  status      ApprovalStatus @default(DRAFT)
  contact     String?
  email       String?
  phone       String?
  address     String?
  rating      Float?
  metadata    Json?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())

  createdBy User?      @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  province  Province?  @relation(fields: [provinceId], references: [id])
  costs     TourCost[]

  @@index([type])
  @@index([provinceId])
}

model TourCost {
  id          String       @id @default(uuid())
  tourId      String
  supplierId  String?
  category    CostCategory
  unitPrice   Decimal      @db.Decimal(12, 2)
  quantity    Int          @default(1)
  /// true = cost scales with pax; false = one charge for the whole group.
  isPerPerson Boolean      @default(true)
  status      ApprovalStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([tourId])
}

// ─────────────────────────────────────────────
// Training tasks, assignments, deadlines and progress
// ─────────────────────────────────────────────
model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  hocPhanId   String
  classId     String
  groupId     String?
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  hocPhan     HocPhan      @relation(fields: [hocPhanId], references: [id])
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  group       StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignments TaskAssignment[]

  @@index([classId, dueAt])
  @@index([groupId])
  @@index([createdById])
}

model TaskAssignment {
  id           String     @id @default(uuid())
  taskId       String
  assigneeId   String
  assignedById String
  status       TaskStatus @default(TODO)
  progress     Int        @default(0)
  note         String?
  submittedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee   User @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy User @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  @@unique([taskId, assigneeId])
  @@index([assigneeId, status])
}

// ─────────────────────────────────────────────
// Public engagement: Rating / Comment / Itinerary
// ─────────────────────────────────────────────
model Rating {
  id            String   @id @default(uuid())
  userId        String
  destinationId String
  score         Int
  review        String?
  moderationStatus ModerationStatus @default(PENDING)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([destinationId])
}

model Favorite {
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([userId, destinationId])
  @@index([destinationId])
}

model Comment {
  id            String   @id @default(uuid())
  userId        String
  destinationId String
  content       String
  moderationStatus ModerationStatus @default(PENDING)
  parentId      String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]   @relation("CommentReplies")

  @@index([destinationId])
}

model Itinerary {
  id        String   @id @default(uuid())
  userId    String
  tourId    String?
  name      String
  payload   Json     // serialized days/items
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tour Tour? @relation(fields: [tourId], references: [id])
}

// ─────────────────────────────────────────────
// Approval engine
// ─────────────────────────────────────────────
model Approval {
  id           String         @id @default(uuid())
  entityType   EntityType
  entityId     String
  currentLevel ApprovalLevel  @default(LEADER)
  status       ApprovalStatus @default(PENDING_LEADER)
  submittedById String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  history ApprovalHistory[]

  @@unique([entityType, entityId])
  @@index([status])
}

model ApprovalHistory {
  id         String         @id @default(uuid())
  approvalId String
  actorId    String
  level      ApprovalLevel
  action     ApprovalAction
  comment    String?
  createdAt  DateTime       @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor    User     @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([approvalId])
}

// ─────────────────────────────────────────────
// Grading (mục III — "📊 Chấm điểm" của từng học phần)
// ─────────────────────────────────────────────
/// The lecturer's final mark. The automatic indicators (% duyệt, % bị sửa, rating…)
/// are derived from live data by GradingService and are never stored here.
model Grade {
  id         String   @id @default(uuid())
  studentId  String
  hocPhanId  String
  classId    String?
  score      Float
  comment    String?
  /// Snapshot of the computed indicators at the moment the mark was given.
  metrics    Json?
  gradedById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student  User    @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User    @relation("GradeGrader", fields: [gradedById], references: [id])
  hocPhan  HocPhan @relation(fields: [hocPhanId], references: [id], onDelete: Cascade)
  class    Class?  @relation(fields: [classId], references: [id])

  @@unique([studentId, hocPhanId])
  @@index([hocPhanId])
}

// ─────────────────────────────────────────────
// System settings — Admin "khóa/mở hệ thống"
// ─────────────────────────────────────────────
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Notification & Audit
// ─────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   // "APPROVAL","RATING","SYSTEM"
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
